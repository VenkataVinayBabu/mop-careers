# Secrets — never commit
.env
*.env
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# Uploads (user content, not source). Git cannot re-include a file whose parent
# directory is excluded, so the directories are un-ignored before the .gitkeep.
backend/uploads/**
!backend/uploads/
!backend/uploads/notes/
!backend/uploads/notes/.gitkeep

# Database dumps from backup.ps1. A dump is every student record, every fee and
# every password hash in one file — it belongs on a drive, never in the repo.
backups/
*.dump
*.sql.gz

# Node
node_modules/
dist/
dist-ssr/
*.local
.vite/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
