# Copy to .env and fill in real values. NEVER commit .env.

# --- Database -------------------------------------------------------------
# Special characters in the password must be URL-encoded (@ -> %40, # -> %23).
DATABASE_URL=postgresql+psycopg2://mop:CHANGE%40ME@localhost:5432/mop_careers

# --- Auth -----------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
RESET_TOKEN_EXPIRE_MINUTES=60

# --- App ------------------------------------------------------------------
# APP_ENV=dev makes the mail helper log to the console instead of sending.
APP_ENV=dev
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Anthropic (Phases 3 & 4) --------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Email (SMTP) ---------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@mopcareers.com
ENQUIRY_EMAIL=enquiries@mopcareers.com
ADMIN_DOUBTS_EMAIL=doubts@mopcareers.com
